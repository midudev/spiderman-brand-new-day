---
import PlayVideoButton from '@/components/PlayVideoButton.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { VIDEOS } from '@/data/content';
---

<section
	id="videos"
	class="videos relative mb-[20vh] min-h-screen bg-neutral-black md:mb-[25vh]"
>
	<h2 class="sr-only">Vídeos</h2>

	<div class="pin-surface justify-center bg-red-dark">
		<div class="videos__viewport">
			<div class="videos__stage">
				{
					VIDEOS.map((video, index) => (
						<figure
							data-video-card
							class="videos__card group"
							style={`--i: ${index}`}
						>
							<ResponsiveImage
								base={video.base}
								widths={[640, 1280]}
								sizes="(min-width: 768px) 40rem, 72vw"
								width={1280}
								height={683}
								alt={video.alt}
								pictureClass="block size-full"
								class="size-full object-cover"
							/>

							<span class="videos__play">
								<PlayVideoButton
									label={`Reproducir: ${video.title}`}
									data-trailer-open={video.id}
								/>
							</span>
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.videos__viewport {
		width: 100%;
		padding-block: clamp(6rem, 12vh, 9rem);
		perspective: 1400px;
		perspective-origin: 50% 50%;
	}

	.videos__stage {
		position: relative;
		display: grid;
		width: 100%;
		place-items: center;
		isolation: isolate;
	}

	/* 72vw y no 82: en móvil la tarjeta se desplaza en lateral y se inclina, y
	   ambas cosas ensanchan su caja. Con 82vw el margen que quedaba se lo comían
	   entre las dos y llegaba a rozar el borde en pantallas estrechas, donde el
	   mínimo del `clamp` además forzaba un ancho mayor que el 82vw. */
	.videos__card {
		position: relative;
		grid-area: 1 / 1;
		width: clamp(13rem, 72vw, 40rem);
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background-color: var(--color-neutral-dark);
		transform-style: preserve-3d;
		will-change: transform, opacity;
		box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
	}

	.videos__play {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
	}

	/* En la cascada la tarjeta siguiente tapa el 40% inferior de la anterior y
	   además va por encima en `zIndex`, que es justo donde vivía el play: se veía
	   pero no se podía pulsar. Arriba no lo tapa nadie —el solape sólo crece
	   hacia abajo— y quedan ~40px de aire hasta el borde de la de después. El
	   corte replica el de la cascada en el script, movimiento reducido incluido:
	   ahí las tarjetas se apilan en columna sin solape y el play se queda abajo. */
	@media (max-width: 767px) and (orientation: portrait) and (prefers-reduced-motion: no-preference) {
		.videos__play {
			top: 0.75rem;
			bottom: auto;
		}
	}

	.videos__play :global(.play-video-button) {
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.videos__play:hover :global(.play-video-button),
	.videos__play:focus-within :global(.play-video-button) {
		transform: scale(1.08);
	}

	@media (min-width: 768px) {
		.videos__card {
			width: clamp(28rem, 55vw, 40rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.videos__stage {
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
			padding-inline: 9vw;
		}

		/* Sigue `relative`: el play va absoluto contra su tarjeta, y con `static`
		   se anclaba al `.videos__stage` y los tres se amontonaban en su esquina. */
		.videos__card {
			grid-area: auto;
			width: min(100%, 40rem);
		}
	}
</style>

<script>
	import { gsap, prefersReducedMotion } from '@/lib/gsap';
	import { $, $$ } from '@/lib/dom';
	import { createPinnedTiltSection } from '@/lib/tilt';
	import {
		arrivalAt,
		cascadeDistance,
		isCascade,
		renderCascade
	} from '@/lib/cascade';

	const section = $<HTMLElement>('#videos');
	const surface = section ? $<HTMLElement>('.pin-surface', section) : null;
	const cards = section ? $$<HTMLElement>('[data-video-card]', section) : [];

	if (section && surface && cards.length && !prefersReducedMotion()) {
		const stackedPose = (index: number, top: number) => {
			const depth = top - index;
			if (depth <= 0) {
				return { x: 0, y: 0, rotate: 0, scale: 1, autoAlpha: 1 };
			}
			const sign = depth % 2 === 1 ? -1 : 1;
			return {
				x: sign * (16 + depth * 14),
				y: depth * 10,
				rotate: sign * (4 + depth * 2.5),
				scale: 1 - depth * 0.03,
				autoAlpha: 1
			};
		};

		const incomingPose = () => ({
			x: 0,
			y: Math.min(520, window.innerHeight * 0.55),
			rotate: 6,
			scale: 0.94,
			autoAlpha: 0
		});

		/* Sin ramificar, a diferencia de Galería: el mazo apila con
		   desplazamientos de ~20px y la cascada reparte el mismo scroll entre las
		   mismas tarjetas, así que a las dos les vale la distancia de la cascada.
		   El porqué de que el modo se decida por vertical vive con la consulta,
		   en `lib/cascade`. */
		createPinnedTiltSection({
			section,
			surface,
			mainDistance: () => cascadeDistance(cards.length),
			onProgress: (stackProgress) => {
				const arrival = arrivalAt(stackProgress, cards.length);

				/* En móvil no se hace mazo: las tarjetas caen en cascada solapada y
				   todas se quedan a la vista, cada una con su play. Es la misma pieza
				   que usa Galería, de ahí que viva en `lib`. */
				if (isCascade()) {
					renderCascade({ cards, arrival, badge: '.videos__play' });
					return;
				}

				// El mazo va con el progreso crudo, sin la curva de la cascada.
				const { settled, frac, top } = arrival;

				cards.forEach((card, index) => {
					const play = card.querySelector<HTMLElement>('.videos__play');

					if (index <= settled) {
						const from = stackedPose(index, settled);
						const to = stackedPose(index, top);
						gsap.set(card, {
							x: gsap.utils.interpolate(from.x, to.x, frac),
							y: gsap.utils.interpolate(from.y, to.y, frac),
							rotate: gsap.utils.interpolate(from.rotate, to.rotate, frac),
							scale: gsap.utils.interpolate(from.scale, to.scale, frac),
							autoAlpha: 1,
							// La cascada lo pone a `none` mientras la tarjeta no ha entrado.
							// El mazo tiene que devolverlo o, al girar el móvil a
							// horizontal, la tarjeta se vería puesta y no aceptaría clics.
							pointerEvents: 'auto',
							zIndex: index + 1
						});
						// En el mazo sólo lleva play la de arriba: las de debajo asoman
						// por el borde y el suyo caería sobre la tarjeta que las tapa.
						if (play) gsap.set(play, { autoAlpha: index === top ? 1 : 0 });
						return;
					}

					if (index === settled + 1) {
						const incoming = incomingPose();
						const stacked = stackedPose(index, index);
						gsap.set(card, {
							x: gsap.utils.interpolate(incoming.x, stacked.x, frac),
							y: gsap.utils.interpolate(incoming.y, stacked.y, frac),
							rotate: gsap.utils.interpolate(
								incoming.rotate,
								stacked.rotate,
								frac
							),
							scale: gsap.utils.interpolate(incoming.scale, stacked.scale, frac),
							autoAlpha: gsap.utils.interpolate(
								incoming.autoAlpha,
								stacked.autoAlpha,
								frac
							),
							pointerEvents: 'auto',
							zIndex: index + 1
						});
						if (play) gsap.set(play, { autoAlpha: frac > 0.55 ? 1 : 0 });
						return;
					}

					gsap.set(card, {
						...incomingPose(),
						pointerEvents: 'none',
						zIndex: index + 1
					});
					if (play) gsap.set(play, { autoAlpha: 0 });
				});
			}
		});
	} else if (section && surface && cards.length) {
		gsap.set(surface, { clearProps: 'clipPath,transform' });
		gsap.set(cards, { clearProps: 'transform,opacity,zIndex' });
	}
</script>
