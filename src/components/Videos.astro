---
import PlayVideoButton from '@/components/PlayVideoButton.astro';
import ResponsiveImage from '@/components/ResponsiveImage.astro';
import { VIDEOS } from '@/data/content';
---

<section
	id="videos"
	class="videos relative mb-[20vh] min-h-screen bg-neutral-black md:mb-[25vh]"
>
	<h2 class="sr-only">Vídeos</h2>

	<div class="pin-surface justify-center bg-red-dark">
		<div class="videos__viewport">
			<div class="videos__stage">
				{
					VIDEOS.map((video, index) => (
						<figure
							data-video-card
							class="videos__card group"
							style={`--i: ${index}`}
						>
							<ResponsiveImage
								base={video.base}
								widths={[640, 1280]}
								sizes="(min-width: 768px) 40rem, 72vw"
								width={1280}
								height={683}
								alt={video.alt}
								pictureClass="block size-full"
								class="size-full object-cover"
							/>

							<span class="videos__play">
								<PlayVideoButton
									label={`Reproducir: ${video.title}`}
									data-trailer-open={video.id}
								/>
							</span>
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.videos__viewport {
		width: 100%;
		padding-block: clamp(6rem, 12vh, 9rem);
		perspective: 1400px;
		perspective-origin: 50% 50%;
	}

	.videos__stage {
		position: relative;
		display: grid;
		width: 100%;
		place-items: center;
		isolation: isolate;
	}

	/* 72vw y no 82: en móvil la tarjeta se desplaza en lateral y se inclina, y
	   ambas cosas ensanchan su caja. Con 82vw el margen que quedaba se lo comían
	   entre las dos y llegaba a rozar el borde en pantallas estrechas, donde el
	   mínimo del `clamp` además forzaba un ancho mayor que el 82vw. */
	.videos__card {
		position: relative;
		grid-area: 1 / 1;
		width: clamp(13rem, 72vw, 40rem);
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background-color: var(--color-neutral-dark);
		transform-style: preserve-3d;
		will-change: transform, opacity;
		box-shadow: 0 18px 40px rgb(0 0 0 / 0.35);
	}

	.videos__play {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
	}

	/* En la cascada la tarjeta siguiente tapa el 40% inferior de la anterior y
	   además va por encima en `zIndex`, que es justo donde vivía el play: se veía
	   pero no se podía pulsar. Arriba no lo tapa nadie —el solape sólo crece
	   hacia abajo— y quedan ~40px de aire hasta el borde de la de después. El
	   corte replica el de la cascada en el script, movimiento reducido incluido:
	   ahí las tarjetas se apilan en columna sin solape y el play se queda abajo. */
	@media (max-width: 767px) and (orientation: portrait) and (prefers-reduced-motion: no-preference) {
		.videos__play {
			top: 0.75rem;
			bottom: auto;
		}
	}

	.videos__play :global(.play-video-button) {
		transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.videos__play:hover :global(.play-video-button),
	.videos__play:focus-within :global(.play-video-button) {
		transform: scale(1.08);
	}

	@media (min-width: 768px) {
		.videos__card {
			width: clamp(28rem, 55vw, 40rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.videos__stage {
			display: flex;
			flex-direction: column;
			gap: 1.25rem;
			padding-inline: 9vw;
		}

		/* Sigue `relative`: el play va absoluto contra su tarjeta, y con `static`
		   se anclaba al `.videos__stage` y los tres se amontonaban en su esquina. */
		.videos__card {
			grid-area: auto;
			width: min(100%, 40rem);
		}
	}
</style>

<script>
	import { gsap, prefersReducedMotion } from '@/lib/gsap';
	import { $, $$ } from '@/lib/dom';
	import { createPinnedTiltSection } from '@/lib/tilt';

	const section = $<HTMLElement>('#videos');
	const surface = section ? $<HTMLElement>('.pin-surface', section) : null;
	const cards = section ? $$<HTMLElement>('[data-video-card]', section) : [];

	if (section && surface && cards.length && !prefersReducedMotion()) {
		const PER_CARD = 0.85;

		/* El ancho manda para el tamaño de la tarjeta, pero la cascada necesita
		   además alto: ocupa 2,2 alturas de tarjeta, y como el `grid-area` común
		   deja el `.pin-surface` de la altura de una sola, tumbado no cabe y el
		   `overflow: hidden` recorta. En vertical siempre entra: la tarjeta mide
		   72vw, así que el grupo son ~0,89vw de alto contra un mínimo de 100vh.
		   Fuera de ahí manda el mazo, que apila con desplazamientos de ~20px.
		   La consulta se crea una vez y se lee `.matches`, que es vivo: `poseFor`
		   e `incomingFor` se llaman varias veces por tarjeta y por frame. */
		const cascadeQuery = window.matchMedia(
			'(max-width: 767px) and (orientation: portrait)'
		);

		const stackedPose = (index: number, top: number) => {
			const depth = top - index;
			if (depth <= 0) {
				return { x: 0, y: 0, rotate: 0, scale: 1, autoAlpha: 1 };
			}
			const sign = depth % 2 === 1 ? -1 : 1;
			return {
				x: sign * (16 + depth * 14),
				y: depth * 10,
				rotate: sign * (4 + depth * 2.5),
				scale: 1 - depth * 0.03,
				autoAlpha: 1
			};
		};

		const incomingPose = () => ({
			x: 0,
			y: Math.min(520, window.innerHeight * 0.55),
			rotate: 6,
			scale: 0.94,
			autoAlpha: 0
		});

		/* En móvil no se hace mazo: las tarjetas caen en cascada solapada y todas
		   se quedan a la vista, cada una con su play. Las medidas van en fracciones
		   de la propia tarjeta, así que no hay que retocarlas si cambia su tamaño. */
		const CASCADE_STEP = 0.6;
		const CASCADE_SHIFT = 0.05;
		const CASCADE_TILT = 2;

		/* El grupo va centrado en los dos ejes contra el punto medio de las que ya
		   han llegado. En vertical eso es `top / 2`; en horizontal hay que restar
		   además la media de los signos alternos, que sólo vale cero cuando son
		   pares: sin esta corrección una sola tarjeta nace desplazada un `SHIFT`
		   entero y con tres el conjunto se escora. */
		const shiftMean = (top: number) => {
			const arrived = top + 1;
			return arrived % 2 === 0 ? 0 : -1 / arrived;
		};

		const cascadePose = (index: number, top: number) => {
			const card = cards[0];
			const sign = index % 2 === 0 ? -1 : 1;
			return {
				x: (sign - shiftMean(top)) * CASCADE_SHIFT * card.offsetWidth,
				y: (index - top / 2) * CASCADE_STEP * card.offsetHeight,
				rotate: sign * CASCADE_TILT,
				scale: 1,
				autoAlpha: 1
			};
		};

		const cascadeIncoming = () => ({
			x: 0,
			y: Math.min(420, window.innerHeight * 0.45),
			rotate: 0,
			scale: 0.96,
			autoAlpha: 0
		});

		/* `offsetWidth/Height` y no `getBoundingClientRect`: las tarjetas ya llevan
		   transform encima y hacen falta las medidas de maquetación, no las
		   pintadas. Se leen en cada frame porque el pin sobrevive al resize. */
		const poseFor = (index: number, top: number) =>
			cascadeQuery.matches
				? cascadePose(index, top)
				: stackedPose(index, top);

		const incomingFor = () =>
			cascadeQuery.matches ? cascadeIncoming() : incomingPose();

		/* En la cascada el tramo de cada tarjeta se recorre con una curva suave en
		   vez de a ritmo plano, para que aterrice en su sitio. `power1.out` y no
		   algo de grado mayor: aplana poco al final, así no parece que se detenga
		   antes de que termine su tramo de scroll. El mazo sigue con el progreso
		   crudo: la PR no toca escritorio. */
		const settle = gsap.parseEase('power1.out');

		const stackDistance = () =>
			Math.max(1, (cards.length - 1) * window.innerHeight * PER_CARD);

		createPinnedTiltSection({
			section,
			surface,
			mainDistance: stackDistance,
			onProgress: (stackProgress) => {
				const arriving = stackProgress * (cards.length - 1);
				const fullyStacked = Math.floor(arriving);
				const frac = arriving - fullyStacked;
				const nextTop = Math.min(
					cards.length - 1,
					fullyStacked + (frac > 0 ? 1 : 0)
				);
				const cascading = cascadeQuery.matches;

				// Mismo valor suavizado para todas: las que ya están y la que entra se
				// recolocan en bloque, así el grupo no se descuadra a mitad del tramo.
				const eased = cascading ? settle(frac) : frac;

				cards.forEach((card, index) => {
					const play = card.querySelector<HTMLElement>('.videos__play');

					if (index <= fullyStacked) {
						const from = poseFor(index, fullyStacked);
						const to = poseFor(index, nextTop);
						gsap.set(card, {
							x: gsap.utils.interpolate(from.x, to.x, eased),
							y: gsap.utils.interpolate(from.y, to.y, eased),
							rotate: gsap.utils.interpolate(from.rotate, to.rotate, eased),
							scale: gsap.utils.interpolate(from.scale, to.scale, eased),
							autoAlpha: 1,
							zIndex: index + 1
						});
						if (play) {
							// En la cascada todas las tarjetas quedan a la vista, así que
							// cada una conserva su play; en el mazo sólo lo lleva la de arriba.
							gsap.set(play, {
								autoAlpha: cascading || index === nextTop ? 1 : 0
							});
						}
						return;
					}

					if (index === fullyStacked + 1) {
						const incoming = incomingFor();
						const stacked = poseFor(index, index);
						gsap.set(card, {
							x: gsap.utils.interpolate(incoming.x, stacked.x, eased),
							y: gsap.utils.interpolate(incoming.y, stacked.y, eased),
							rotate: gsap.utils.interpolate(
								incoming.rotate,
								stacked.rotate,
								eased
							),
							scale: gsap.utils.interpolate(
								incoming.scale,
								stacked.scale,
								eased
							),
							autoAlpha: gsap.utils.interpolate(
								incoming.autoAlpha,
								stacked.autoAlpha,
								eased
							),
							zIndex: index + 1
						});
						if (play) gsap.set(play, { autoAlpha: frac > 0.55 ? 1 : 0 });
						return;
					}

					gsap.set(card, { ...incomingFor(), zIndex: index + 1 });
					if (play) gsap.set(play, { autoAlpha: 0 });
				});
			}
		});
	} else if (section && surface && cards.length) {
		gsap.set(surface, { clearProps: 'clipPath,transform' });
		gsap.set(cards, { clearProps: 'transform,opacity,zIndex' });
	}
</script>
