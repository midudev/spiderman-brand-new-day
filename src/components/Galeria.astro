---
import Close from '@/assets/icons/close.svg'
import Plus from '@/assets/icons/plus.svg'
import ArrowRight from '@/assets/icons/arrow-right.svg'
import ResponsiveImage from '@/components/ResponsiveImage.astro'
import { GALLERY_IMAGES } from '@/data/content'

const galleryJson = JSON.stringify(
	GALLERY_IMAGES.map(({ base, alt }) => ({
		base,
		alt,
		avif: `/images/${base}-1280.avif`,
		webp: `/images/${base}-1280.webp`
	}))
)
---

<section
	id="galeria"
	class="galeria relative mb-[20vh] min-h-screen bg-neutral-black md:mb-[25vh]"
>
	<h2 class="sr-only">Galería</h2>

	<div class="pin-surface bg-blue-dark">
		<div class="galeria__viewport">
			<div class="galeria__stage">
				{
					GALLERY_IMAGES.map((image, index) => (
						<figure
							data-galeria-item
							data-galeria-index={index}
							class="galeria__card group"
						>
							<ResponsiveImage
								base={image.base}
								widths={[640, 1280]}
								sizes="(min-width: 768px) 40vw, 72vw"
								width={1280}
								height={683}
								alt={image.alt}
								pictureClass="block size-full"
								class="pointer-events-none size-full object-cover"
							/>

							<button
								type="button"
								data-galeria-open={index}
								class="absolute inset-0 z-[1] cursor-zoom-in"
								aria-label={`Ampliar: ${image.alt}`}
							>
								<span
									data-galeria-badge
									class="pointer-events-none absolute right-3 bottom-3 grid size-9 place-items-center rounded-full bg-neutral-white text-neutral-black transition-transform duration-200 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.08] group-focus-within:scale-[1.08] group-focus-within:outline-2 group-focus-within:outline-offset-2 group-focus-within:outline-neutral-white"
								>
									<Plus class="size-3.5" aria-hidden="true" />
								</span>
							</button>
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>

<dialog
	data-galeria-lightbox
	data-images={galleryJson}
	class="galeria-lightbox m-auto max-h-[100dvh] w-[min(96vw,72rem)] overflow-hidden border-0 bg-transparent p-0"
	aria-labelledby="galeria-lightbox-title"
>
	<div
		data-galeria-panel
		class="relative flex w-full flex-col items-center gap-3 px-12 pt-14 pb-4 md:px-16"
	>
		<h2 id="galeria-lightbox-title" class="sr-only">Imagen ampliada</h2>

		<button
			type="button"
			data-galeria-close
			class="absolute top-0 right-12 z-[1] grid size-10 place-items-center rounded-full bg-neutral-dark/60 text-neutral-white backdrop-blur-md transition-colors hover:bg-neutral-dark/80 focus-visible:bg-neutral-dark/80 md:right-16"
			aria-label="Cerrar imagen"
		>
			<Close class="size-3.5" aria-hidden="true" />
		</button>

		<div class="relative w-full">
			<button
				type="button"
				data-galeria-prev
				class="absolute top-1/2 left-2 z-[1] grid size-10 -translate-y-1/2 place-items-center rounded-full bg-neutral-dark/60 text-neutral-white backdrop-blur-md transition-colors hover:bg-neutral-dark/80 focus-visible:bg-neutral-dark/80 md:left-3"
				aria-label="Imagen anterior"
			>
				<ArrowRight class="size-4 rotate-180" aria-hidden="true" />
			</button>

			<button
				type="button"
				data-galeria-next
				class="absolute top-1/2 right-2 z-[1] grid size-10 -translate-y-1/2 place-items-center rounded-full bg-neutral-dark/60 text-neutral-white backdrop-blur-md transition-colors hover:bg-neutral-dark/80 focus-visible:bg-neutral-dark/80 md:right-3"
				aria-label="Imagen siguiente"
			>
				<ArrowRight class="size-4" aria-hidden="true" />
			</button>

			<figure class="galeria-lightbox__frame overflow-hidden shadow-[0_24px_64px_rgb(0_0_0_/_0.45)]">
				<picture>
					<source data-galeria-source type="image/avif" />
					<img
						data-galeria-img
						src=""
						alt=""
						width="1280"
						height="683"
						class="block h-auto max-h-[min(72dvh,40rem)] w-full object-contain"
						decoding="async"
					/>
				</picture>
			</figure>
		</div>

		<p
			data-galeria-counter
			class="font-display text-title-small uppercase tracking-wide text-neutral-white/70"
			aria-live="polite"
		>
		</p>
	</div>
</dialog>

<style>
	.galeria__viewport {
		width: 100%;
		overflow: hidden;
		padding-block: clamp(6rem, 12vh, 9rem);
		perspective: 1400px;
		perspective-origin: 50% 50%;
	}

	.galeria__stage {
		display: flex;
		width: max-content;
		align-items: center;
		gap: clamp(0.75rem, 2vw, 1.75rem);
		will-change: transform;
	}

	.galeria__card {
		position: relative;
		width: clamp(18rem, 78vw, 42rem);
		flex: 0 0 auto;
		aspect-ratio: 1920 / 1024;
		overflow: hidden;
		background-color: var(--color-neutral-dark);
		transform-style: preserve-3d;
		will-change: transform, clip-path;
		clip-path: polygon(0% 0%, 100% 7%, 100% 100%, 0% 93%);
	}

	@media (min-width: 768px) {
		.galeria__card {
			width: clamp(24rem, 40vw, 42rem);
		}
	}

	/* En móvil vertical no hay abanico: la pista deja de ser una fila y pasa a ser
	   una pila, con las tres tarjetas en la misma celda. Quien las separa es el
	   script, que las coloca en cascada; aquí sólo se prepara el terreno.
	   72vw y no 78: el corte diagonal se come esquina y media de la tarjeta, así
	   que a 78 el aire que le queda al grupo contra los bordes se vuelve desigual
	   según hacia dónde caiga cada una. */
	@media (max-width: 767px) and (orientation: portrait) and (prefers-reduced-motion: no-preference) {
		/* El recorte pasa a `.pin-surface`, que ocupa el ancho de la ventana: es lo
		   que esconde la tarjeta que aún no ha entrado sin cortar la cascada, que
		   crece hacia arriba y hacia abajo. */
		.galeria__viewport {
			overflow: visible;
		}

		.galeria__stage {
			display: grid;
			width: 100%;
			place-items: center;
			gap: 0;
			isolation: isolate;
		}

		.galeria__card {
			grid-area: 1 / 1;
			width: clamp(13rem, 72vw, 40rem);
		}

		/* En la cascada la tarjeta siguiente tapa la franja inferior de la anterior
		   y además va por encima en `zIndex`, que es justo donde vivía el «+»: se
		   veía a medias y no se podía pulsar del todo. Arriba no lo tapa nadie, el
		   solape sólo crece hacia abajo.
		   `.galeria__card` delante es por lo que dice —el «+» sólo se mueve dentro
		   de una tarjeta—, no para ganar especificidad: contra el `bottom-3` de
		   Tailwind no hay pelea que ganar. Las utilidades se emiten dentro de
		   `@layer utilities`, y una regla sin capa gana siempre a una con capa sea
		   cual sea su especificidad y el orden de los ficheros. Suelto también
		   funcionaría: Astro sí le pone su atributo de scope a un selector que es
		   sólo `[attr]`.

		   El 12% es la caída del corte diagonal (el mismo de `CLIP_RIGHT` en el
		   script): en las tarjetas que caen hacia la derecha ese corte se lleva el
		   triángulo superior derecho, que es justo donde vive el «+», y arriba del
		   todo salía cortado. Sumado al aire de 0.75rem deja el botón entero por
		   debajo de la diagonal. En porcentaje y no en píxeles porque el corte
		   también es proporcional: así la distancia al borde inclinado sale la
		   misma —unos 14px— sea cual sea el tamaño de la tarjeta. Las que caen
		   hacia el otro lado tienen la esquina intacta y no lo necesitarían, pero
		   se bajan igual para que los tres botones queden a la misma altura. */
		.galeria__card [data-galeria-badge] {
			top: calc(12% + 0.75rem);
			bottom: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.galeria__viewport {
			overflow-x: auto;
			scroll-snap-type: x mandatory;
		}

		.galeria__stage {
			padding-inline: 9vw;
		}

		.galeria__card {
			scroll-snap-align: center;
		}
	}

	.galeria-lightbox {
		overflow: hidden;
		scrollbar-width: none;
	}

	.galeria-lightbox::-webkit-scrollbar {
		display: none;
	}

	.galeria-lightbox::backdrop {
		background-color: rgb(0 0 4 / 0.9);
		backdrop-filter: blur(8px);
	}
</style>

<script>
	import { gsap, prefersReducedMotion } from '@/lib/gsap'
	import { $, $$, isDocumentScrollKey } from '@/lib/dom'
	import { createPinnedTiltSection } from '@/lib/tilt'
	import {
		arrivalAt,
		cascadeDistance,
		isCascade,
		renderCascade
	} from '@/lib/cascade'

	type GalleryImage = {
		base: string
		alt: string
		avif: string
		webp: string
	}

	const section = $<HTMLElement>('#galeria')
	const surface = section ? $<HTMLElement>('.pin-surface', section) : null
	const viewport = section ? $<HTMLElement>('.galeria__viewport', section) : null
	const track = section ? $<HTMLElement>('.galeria__stage', section) : null
	const cards = section ? $$<HTMLElement>('[data-galeria-item]', section) : []

	if (section && surface && viewport && track && cards.length && !prefersReducedMotion()) {
		const CLIP_LEFT = 'polygon(0% 12%, 100% 0%, 100% 100%, 0% 88%)'
		const CLIP_CENTER = 'polygon(0% 0%, 100% 7%, 100% 100%, 0% 93%)'
		const CLIP_RIGHT = 'polygon(0% 0%, 100% 12%, 100% 88%, 0% 100%)'

		const cardCenter = (card: HTMLElement) =>
			card.offsetLeft + card.offsetWidth / 2
		const viewportCenter = () => viewport.clientWidth / 2
		const startX = () => viewportCenter() - cardCenter(cards[cards.length - 1])
		const endX = () => viewportCenter() - cardCenter(cards[0])
		const travel = () => Math.max(1, Math.abs(endX() - startX()))

		const badgeOf = (card: HTMLElement) =>
			card.querySelector<HTMLElement>('[data-galeria-badge]')

		const updateFan = (trackX: number) => {
			const center = viewportCenter()
			const step =
				cards.length > 1
					? cardCenter(cards[1]) - cardCenter(cards[0])
					: cards[0].offsetWidth

			cards.forEach((card) => {
				const offset = cardCenter(card) + trackX - center
				const position = gsap.utils.clamp(-1, 1, offset / step)
				const distance = Math.abs(position)
				const clipPath =
					position < 0
						? gsap.utils.interpolate(CLIP_CENTER, CLIP_LEFT, distance)
						: gsap.utils.interpolate(CLIP_CENTER, CLIP_RIGHT, distance)

				gsap.set(card, {
					// Deshace la pose de la cascada al cruzar el breakpoint: el abanico
					// no escribe estas cuatro y se quedarían pegadas de la otra
					// animación. `pointerEvents` es la que más se notaría: la cascada lo
					// pone a `none` en la tarjeta que aún no ha entrado, y sin devolverlo
					// aquí esa tarjeta seguiría sin aceptar clics ya puesta en el abanico.
					x: 0,
					rotate: 0,
					autoAlpha: 1,
					pointerEvents: 'auto',
					rotateY: -position * 28,
					rotateX: distance * 2,
					scale: 1 - distance * 0.06,
					y: distance * 12,
					clipPath,
					transformOrigin:
						position < -0.05
							? '100% 50%'
							: position > 0.05
								? '0% 50%'
								: '50% 50%',
					zIndex: Math.round(10 - distance * 9)
				})

				const badge = badgeOf(card)
				if (badge) gsap.set(badge, { autoAlpha: 1 })
			})
		}

		/* ——— Cascada (móvil vertical) ———
		   En móvil la galería no hace abanico: las tarjetas caen una a una y se
		   quedan todas a la vista, solapadas. El movimiento es exactamente el de la
		   sección de Vídeos, así que lo pone `lib/cascade`; aquí sólo se le añade
		   lo que es propio de la galería: el escalonado corto, el corte diagonal de
		   cada tarjeta y deshacer la pose que dejó el abanico al cruzar el
		   breakpoint. */

		/* Casi centradas, a diferencia de Vídeos, que escalona con el 0.05 de serie.
		   Lo pide el Figma y aquí además se sostiene solo: quien marca el quiebro en
		   la galería es el corte diagonal, que alterna a lo grande, así que el
		   desplazamiento lateral sobra como refuerzo. */
		const CASCADE_SHIFT = 0.03

		/* El abanico escribe rotaciones 3D, escala y origen que la cascada no toca;
		   sin esto se quedarían pegadas al girar el móvil a vertical. */
		const FAN_RESET = {
			rotateY: 0,
			rotateX: 0,
			transformOrigin: '50% 50%'
		}

		/* El corte marcado del abanico —el mismo 12%, no el 7% de reposo—, fijo en
		   cada tarjeta y alternando el sentido: la que cae hacia la derecha va
		   seguida de una que cae al revés, así los bordes que se tocan abren en uve
		   en vez de quedar paralelos. Los nombres vienen del abanico, donde marcan
		   posición; aquí son sólo las dos formas. */
		const cascadeClip = (index: number) =>
			index % 2 === 0 ? CLIP_RIGHT : CLIP_LEFT

		const cascadeExtra = (index: number) => ({
			...FAN_RESET,
			clipPath: cascadeClip(index)
		})

		const pin = createPinnedTiltSection({
			section,
			surface,
			mainDistance: () =>
				isCascade() ? cascadeDistance(cards.length) : travel(),
			onProgress: (progress) => {
				if (isCascade()) {
					// La pista es una pila, no una fila: el desplazamiento del abanico
					// aquí correría el grupo entero.
					gsap.set(track, { x: 0 })
					renderCascade({
						cards,
						arrival: arrivalAt(progress, cards.length),
						badge: '[data-galeria-badge]',
						extra: cascadeExtra,
						shift: CASCADE_SHIFT
					})
					return
				}

				const x = gsap.utils.interpolate(startX(), endX(), progress)
				gsap.set(track, { x })
				updateFan(x)
			}
		})

		/* Tabular por las tarjetas mueve el scroll hasta el punto del pin en el que
		   la enfocada está en su sitio; si no, el foco se iría a una tarjeta que
		   todavía no ha entrado. En la cascada ese punto es su propio tramo, ya que
		   llegan en orden; en el abanico hay que deshacer la cuenta del carrusel. */
		const progressFor = (card: HTMLElement) =>
			isCascade()
				? cards.indexOf(card) / Math.max(1, cards.length - 1)
				: gsap.utils.clamp(
						0,
						1,
						(viewportCenter() - cardCenter(card) - startX()) / (endX() - startX())
					)

		viewport.addEventListener('focusin', (event) => {
			const target = event.target
			if (!(target instanceof HTMLElement) || !target.matches(':focus-visible'))
				return
			const card = target.closest<HTMLElement>('[data-galeria-item]')
			if (!card) return
			const distance = isCascade()
				? cascadeDistance(cards.length)
				: travel()
			viewport.scrollLeft = 0
			window.scrollTo(0, pin.start + progressFor(card) * distance)
		})
	} else if (section && surface && track && cards.length) {
		gsap.set(surface, { clearProps: 'clipPath,transform' })
		gsap.set(track, { clearProps: 'transform' })
		gsap.set(cards, { clearProps: 'transform,zIndex,clipPath' })
	}

	// ——— Lightbox ———
	const lightbox = $<HTMLDialogElement>('[data-galeria-lightbox]')
	const img = lightbox ? $<HTMLImageElement>('[data-galeria-img]', lightbox) : null
	const source = lightbox ? $<HTMLSourceElement>('[data-galeria-source]', lightbox) : null
	const counter = lightbox ? $<HTMLElement>('[data-galeria-counter]', lightbox) : null
	const closeBtn = lightbox ? $<HTMLButtonElement>('[data-galeria-close]', lightbox) : null
	const prevBtn = lightbox ? $<HTMLButtonElement>('[data-galeria-prev]', lightbox) : null
	const nextBtn = lightbox ? $<HTMLButtonElement>('[data-galeria-next]', lightbox) : null

	const images = (() => {
		try {
			return JSON.parse(lightbox?.dataset.images ?? '[]') as GalleryImage[]
		} catch {
			return [] as GalleryImage[]
		}
	})()

	if (lightbox && img && source && counter && images.length) {
		const panel = $<HTMLElement>('[data-galeria-panel]', lightbox)
		let index = 0
		let navToken = 0

		const blockBackgroundScroll = (event: Event) => {
			if (event instanceof WheelEvent && event.ctrlKey) return
			if (window.TouchEvent && event instanceof TouchEvent && event.touches.length > 1) return
			event.preventDefault()
		}

		const applyImage = () => {
			const item = images[index]
			source.srcset = item.avif
			img.src = item.webp
			img.alt = item.alt
			counter.textContent = `${index + 1} / ${images.length}`
		}

		const show = async (next: number, direction = 0) => {
			const token = ++navToken
			// Comprometer el índice de forma síncrona, antes de cualquier await: los
			// handlers leen `index` en el momento del clic, y si la mutación esperase
			// al await, varios clics rápidos leerían el mismo valor y todos apuntarían
			// al mismo destino (avanzaba 1 en vez de N).
			index = (next + images.length) % images.length

			if (!direction || prefersReducedMotion()) {
				gsap.killTweensOf(img)
				gsap.set(img, { clearProps: 'transform,opacity,visibility' })
				applyImage()
				return
			}

			// El killTweensOf de show() es lo que corta el fade anterior: GSAP no resuelve
			// la promesa del tween al matarlo, así que el guard del navToken de abajo casi
			// nunca corre. No quitar el killTweensOf pensando que el token lo cubre; el
			// token solo protege de verdad tras el decode().
			gsap.killTweensOf(img)
			await gsap.to(img, {
				x: -direction * 40,
				autoAlpha: 0,
				duration: 0.18,
				ease: 'power2.in'
			})
			if (token !== navToken) return

			applyImage()
			try {
				await img.decode()
			} catch {
				// decode puede fallar (p. ej. caché); se anima igual.
			}
			if (token !== navToken) return

			gsap.fromTo(
				img,
				{ x: direction * 40, autoAlpha: 0 },
				{
					x: 0,
					autoAlpha: 1,
					duration: 0.3,
					ease: 'power3.out',
					clearProps: 'transform'
				}
			)
		}

		const open = (next: number) => {
			show(next)
			if (!lightbox.open) {
				lightbox.showModal()
				if (panel && !prefersReducedMotion()) {
					gsap.fromTo(
						panel,
						{ autoAlpha: 0, scale: 0.94, y: 16 },
						{
							autoAlpha: 1,
							scale: 1,
							y: 0,
							duration: 0.35,
							ease: 'power3.out',
							clearProps: 'transform,opacity,visibility'
						}
					)
				}
			}
			// Bloquear rueda/touch del fondo sin tocar overflow del body
			// (eso reseteaba el scroll con los pins de GSAP).
			document.addEventListener('wheel', blockBackgroundScroll, {
				passive: false
			})
			document.addEventListener('touchmove', blockBackgroundScroll, {
				passive: false
			})
		}

		const close = () => {
			if (lightbox.open) lightbox.close()
		}

		for (const trigger of $$<HTMLButtonElement>('[data-galeria-open]')) {
			trigger.addEventListener('click', () => {
				const i = Number(trigger.dataset.galeriaOpen)
				if (Number.isFinite(i)) open(i)
			})
		}

		closeBtn?.addEventListener('click', close)
		prevBtn?.addEventListener('click', () => show(index - 1, -1))
		nextBtn?.addEventListener('click', () => show(index + 1, 1))

		lightbox.addEventListener('click', (event) => {
			if (event.target === lightbox) close()
		})

		lightbox.addEventListener('close', () => {
			document.removeEventListener('wheel', blockBackgroundScroll)
			document.removeEventListener('touchmove', blockBackgroundScroll)
		})

		document.addEventListener('keydown', (event) => {
			if (!lightbox.open) return
			if (event.key === 'ArrowLeft') {
				event.preventDefault()
				show(index - 1, -1)
			} else if (event.key === 'ArrowRight') {
				event.preventDefault()
				show(index + 1, 1)
			} else if (isDocumentScrollKey(event)) {
				event.preventDefault()
			}
		})
	}
</script>
