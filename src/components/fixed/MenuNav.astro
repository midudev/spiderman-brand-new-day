---
// Arriba a la izquierda: un solo botón (icono + sección actual). Al abrirlo,
// la etiqueta deja paso al panel con el índice de secciones. La página de detrás
// no se toca: ni velo, ni desenfoque, ni cambio de opacidad.
import { SECTIONS, PILL } from '@/consts';
import Menu from '@/assets/icons/menu.svg';
import Close from '@/assets/icons/close.svg';

const initial = SECTIONS[0].label;
---

<div data-menu class="pointer-events-auto relative">
	<button
		type="button"
		data-menu-toggle
		aria-label="Abrir menú"
		aria-expanded="false"
		aria-controls="menu-panel"
		class="menu-toggle flex items-stretch gap-[2px]"
	>
		<span
			data-menu-part
			class:list={['grid size-12 shrink-0 place-items-center rounded-full', PILL]}
		>
			<Menu class="w-[18px]" data-menu-icon="open" aria-hidden="true" />
			<Close class="hidden w-3.5" data-menu-icon="close" aria-hidden="true" />
		</span>

		<!-- Ancho fijo: si la píldora creciera con cada nombre de sección, el resto de
		     la fila se movería en cada scroll. 122px = la etiqueta más ancha
		     («Partners», 121px medidos con la fuente ya cargada). -->
		<span
			data-menu-part
			data-menu-current
			class:list={[
				'hidden h-12 w-[122px] items-center gap-[5px] px-4 font-display text-title-small uppercase tracking-wide sm:flex',
				PILL
			]}
		>
			<span class="size-1.5 shrink-0 rounded-full bg-current" aria-hidden="true"></span>
			<span data-current-section aria-live="polite">{initial}</span>
		</span>
	</button>

	<nav id="menu-panel" data-menu-panel hidden aria-label="Secciones" class="menu-panel">
		<ul
			class:list={[
				'flex w-[220px] flex-col px-4 font-display text-title-small uppercase tracking-wide text-neutral-white',
				PILL
			]}
		>
			{
				SECTIONS.map((section) => (
					<li>
						<a
							href={`#${section.id}`}
							data-menu-link={section.id}
							class="flex h-12 items-center gap-[5px] transition-opacity hover:opacity-70"
						>
							<span
								class="size-1.5 shrink-0 rounded-full bg-current opacity-0 data-current:opacity-100"
								aria-hidden="true"
							/>
							{section.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</div>

<style>
	/* Hover/focus del botón entero: oscurece icono y etiqueta a la vez. */
	.menu-toggle:hover [data-menu-part],
	.menu-toggle:focus-visible [data-menu-part] {
		background-color: color-mix(
			in oklab,
			var(--color-neutral-dark) 80%,
			transparent
		);
	}

	/* Al lado del botón (no debajo): el panel sustituye a la píldora de sección. */
	.menu-panel {
		position: absolute;
		top: 0;
		left: calc(3rem + 2px);
		animation: menu-panel-in 0.25s cubic-bezier(0.22, 1, 0.36, 1);
	}

	@keyframes menu-panel-in {
		from {
			opacity: 0;
			translate: -8px 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.menu-panel {
			animation: none;
		}
	}
</style>

<script>
	import { gsap, ScrollTrigger, prefersReducedMotion } from '@/lib/gsap';
	import { SECTIONS, type Section } from '@/consts';
	import { $, $$ } from '@/lib/dom';

	const label = $('[data-current-section]');
	const menu = $('[data-menu]');
	const toggle = $<HTMLButtonElement>('[data-menu-toggle]');
	const panel = $('[data-menu-panel]');
	const current = $('[data-menu-current]');
	const iconOpen = $('[data-menu-icon="open"]');
	const iconClose = $('[data-menu-icon="close"]');

	// ——— Indicador de sección (label + punto activo en el panel) ———
	const setCurrentSection = (section: Section) => {
		if (label && label.textContent !== section.label) label.textContent = section.label;

		for (const link of $$('[data-menu-link]')) {
			const dot = link.firstElementChild;
			dot?.toggleAttribute('data-current', link.dataset.menuLink === section.id);
		}
	};

	let sectionTops = new Map<string, number>();

	const cacheSectionTops = () => {
		sectionTops = new Map();
		for (const section of SECTIONS) {
			const target = $(`#${section.id}`);
			if (!target) continue;
			const pin = ScrollTrigger.getAll().find((trigger) => trigger.pin === target);
			sectionTops.set(
				section.id,
				pin?.start ?? target.getBoundingClientRect().top + window.scrollY
			);
		}
	};

	const updateCurrentSection = () => {
		const viewportCenter = window.scrollY + window.innerHeight / 2;
		let active = SECTIONS[0];

		for (const section of SECTIONS) {
			const top = sectionTops.get(section.id);
			if (top !== undefined && top <= viewportCenter) active = section;
		}

		setCurrentSection(active);
	};

	ScrollTrigger.addEventListener('refresh', () => {
		cacheSectionTops();
		updateCurrentSection();
	});
	window.addEventListener('scroll', updateCurrentSection, { passive: true });
	cacheSectionTops();
	requestAnimationFrame(updateCurrentSection);

	// ——— Aparición al elegir una sección ———
	// En vez de viajar con el scroll, la página se funde, salta de golpe al
	// destino y la sección aparece. Solo se anima la opacidad: un transform
	// sobre <main> crearía un containing block y rompería el `position: fixed`
	// de las secciones pineadas (Vídeos, Galería). El salto usa `sectionTops`,
	// que ya apunta al inicio del pin cuando la sección está pineada.
	// Con `prefers-reduced-motion` no se intercepta el clic: ancla nativa.
	const main = $('main');
	let transition: gsap.core.Timeline | null = null;

	for (const link of $$<HTMLAnchorElement>('[data-menu-link]')) {
		link.addEventListener('click', (event) => {
			// Con modificador (Cmd/Ctrl: pestaña nueva, Shift: ventana nueva,
			// Alt: descarga) se sale antes del preventDefault(): el gesto es
			// del navegador, no de la transición.
			if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

			const id = link.dataset.menuLink;
			const top = id ? sectionTops.get(id) : undefined;
			if (!main || top === undefined || prefersReducedMotion()) return;

			// Ya estamos en el destino: fundir la página para acabar en el mismo
			// sitio sería un parpadeo inútil. El margen absorbe redondeos del scroll.
			if (Math.abs(window.scrollY - top) < 2) return;

			event.preventDefault();
			history.pushState(null, '', `#${id}`);

			transition?.kill();
			transition = gsap
				.timeline()
				.to(main, { autoAlpha: 0, duration: 0.25, ease: 'power1.in' })
				.add(() => {
					window.scrollTo(0, top);
					// El listener de scroll ya recalcula la sección activa, pero
					// llega asíncrono; esto deja el indicador bien antes del fade-in.
					updateCurrentSection();
				})
				.to(main, { autoAlpha: 1, duration: 0.5, ease: 'power2.out' })
				// El preventDefault() de arriba también anula el movimiento de foco
				// del ancla nativa: sin esto, quien navegue con teclado seguiría
				// tabulando desde el principio del documento. No puede enfocarse en
				// el salto: ahí <main> sigue en visibility:hidden por autoAlpha (un
				// elemento oculto no es enfocable) y el primer frame del fade-in
				// lo re-oculta un instante, desenfocando igualmente. Por eso el
				// focus() entra ya arrancado el fade-in, con visibilidad estable.
				// `preventScroll` evita que el focus() pelee con el salto.
				.add(() => {
					const target = id ? $(`#${id}`) : null;
					target?.setAttribute('tabindex', '-1');
					target?.focus({ preventScroll: true });
				}, '<+=0.08');
		});
	}

	// ——— Apertura / cierre del panel ———
	if (menu && toggle && panel && current && iconOpen && iconClose) {
		let open = false;

		const setOpen = (next: boolean) => {
			open = next;
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
			panel.hidden = !open;
			// La píldora lleva `flex`, que gana al `display: none` del atributo
			// `hidden`, así que aquí hace falta apagarla por estilo.
			current.hidden = open;
			current.style.display = open ? 'none' : '';
			iconOpen.classList.toggle('hidden', open);
			iconClose.classList.toggle('hidden', !open);
		};

		toggle.addEventListener('click', () => setOpen(!open));

		for (const link of $$('[data-menu-link]')) {
			link.addEventListener('click', () => setOpen(false));
		}

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && open) {
				setOpen(false);
				toggle.focus();
			}
		});

		// Clic fuera del menú
		document.addEventListener('pointerdown', (event) => {
			if (open && !menu.contains(event.target as Node)) setOpen(false);
		});
	}
</script>
