---
// Arriba a la derecha: comprar entradas. Un solo enlace con forma de ticket:
// dos mitades con bocados circulares (corner-shape: scoop). Al hover/active
// del grupo se separan y rotan un poco (efecto de ticket que se rasga).
import { TICKETS_URL } from "@/consts"
import ArrowRight from "@/assets/icons/arrow-right.svg"
import Ticket from "@/assets/icons/ticket.svg"
---

<a
  href={TICKETS_URL}
  target="_blank"
  rel="noopener noreferrer"
  class="ticket-group pointer-events-auto group flex items-stretch"
  aria-label="Entradas (abre en una pestaña nueva)"
>
  <span
  class={"ticket ticket--left grid size-12 place-items-center"}
  aria-hidden="true"
  >
    {/* Sin la etiqueta al lado, una flecha sola no dice «entradas»: en móvil
        manda el icono de ticket y a partir de `sm` vuelve la flecha. */}
    <Ticket class="size-5 sm:hidden" />
    <ArrowRight class="hidden size-4 sm:block" />
  </span>
  <span
    class={
      "ticket ticket--right hidden h-12 items-center px-6 font-display text-title-small uppercase tracking-wide sm:flex"
    }
  >
    Entradas
  </span>
</a>

<style>
  .ticket-group {
    --notch: 8px;
    --gap: 2px;
    gap: var(--gap);
  }

  .ticket {
    /* Bocados de ticket con corner-shape (sin mask).
       scoop + border-radius = cuarto de círculo cóncavo en cada esquina.
       Fondo, blur y sombras siguen la forma automáticamente. */
    border-radius: var(--notch);
    corner-shape: scoop;
    transition:
      transform 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.2s ease;
  }

  /* El foco del grupo (no de cada mitad) oscurece el fondo. El hover equivalente
     vive en @media (hover: hover): en táctil se quedaría pegado tras el toque. */
  .ticket-group:focus-visible .ticket {
    background-color: color-mix(
      in oklab,
      var(--color-neutral-dark) 80%,
      transparent
    );
  }

  .ticket--left {
    /* Origen en la perforación: al rotar se abre el hueco central. */
    transform-origin: right center;
  }

  .ticket--right {
    transform-origin: left center;
  }

  /* Foco: rotan sobre la perforación y se abren un poco (sin separarse del todo). */
  .ticket-group:focus-visible .ticket--left {
    transform: translateX(-2px) rotate(-4deg);
  }

  .ticket-group:focus-visible .ticket--right {
    transform: translateX(2px) rotate(4deg);
  }

  /* Hover: el mismo efecto, pero sólo donde hay un puntero que pueda pasar por
     encima. En táctil el :hover se queda pegado tras el toque y el botón volvía
     torcido de la pestaña de entradas. */
  @media (hover: hover) {
    .ticket-group:hover .ticket {
      background-color: color-mix(
        in oklab,
        var(--color-neutral-dark) 80%,
        transparent
      );
    }

    .ticket-group:hover .ticket--left {
      transform: translateX(-2px) rotate(-4deg);
    }

    .ticket-group:hover .ticket--right {
      transform: translateX(2px) rotate(4deg);
    }
  }

  /* Active: un poco más abierta. */
  .ticket-group:active .ticket--left {
    transform: translateX(-3px) rotate(-6deg);
  }

  .ticket-group:active .ticket--right {
    transform: translateX(3px) rotate(6deg);
  }

  /* El último del bloque: así anula los transforms de hover, foco y active. */
  @media (prefers-reduced-motion: reduce) {
    .ticket {
      transition: background-color 0.2s ease;
    }

    .ticket-group:hover .ticket--left,
    .ticket-group:focus-visible .ticket--left,
    .ticket-group:active .ticket--left,
    .ticket-group:hover .ticket--right,
    .ticket-group:focus-visible .ticket--right,
    .ticket-group:active .ticket--right {
      transform: none;
    }
  }
</style>
