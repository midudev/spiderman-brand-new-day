---

---

<div
  id="loading"
  class="fixed inset-0 z-50 overflow-hidden bg-red-light"
  role="status"
  aria-live="polite"
  aria-label="Cargando..."
>
  <video
    data-loading-video
    class="absolute inset-0 h-full w-full object-cover"
    autoplay
    muted
    playsinline
    preload="auto"
    aria-hidden="true"
  >
    <source src="/videos/spiderman-loading.webm" type="video/webm" />
    <source src="/videos/spiderman-loading.mp4" type="video/mp4" />
  </video>

  <div class="pointer-events-none absolute inset-0 grid place-items-center">
    <div data-loading-spider class="spider" aria-hidden="true">
      <span class="spider__fill"></span>
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 flex items-end justify-between gap-4 px-6 pb-6 font-display uppercase text-neutral-white text-[clamp(2rem,9vw,8rem)] leading-none md:px-8 md:pb-8"
  >
    <span>CARGANDO...</span>
    <span data-loading-percent>0%</span>
  </div>
</div>

<!-- El overlay solo se quita desde JS (`finish()`), así que sin JS la web se
     queda en una pantalla roja fija. Con el overlay fuera, el contenido
     estático (sinopsis, vídeos, galería, partners) vuelve a ser accesible.
     Las frases del hero se apilan en el mismo `inset-0` y GSAP es quien las
     va mostrando de una en una: sin JS se leerían superpuestas. -->
<noscript>
  <style is:inline>
    #loading {
      display: none;
    }

    [data-hero-phrase] ~ [data-hero-phrase] {
      display: none;
    }
  </style>
</noscript>

<style>
  .spider {
    --progress: 0; /* custom property que usaremos para controlar el fill */
    width: 55px;
    height: 89px;
    mask: url(/images/spider-animate.svg) no-repeat center / contain;
    background-color: --alpha(var(--color-neutral-white) / 25%);
  }

  .spider__fill {
    display: block;
    height: 100%;
    background-color: var(--color-neutral-white);
    transform: scaleY(var(--progress));
    transform-origin: bottom;
  }
</style>

<script>
  import { $ } from "@/lib/dom"
  import { gsap, prefersReducedMotion } from "@/lib/gsap"
  import { markLoadingDone, markLoadingReady } from "@/lib/loading"

  const $overlay = $("#loading")
  const $video = $("[data-loading-video]") as HTMLVideoElement | null
  const $percent = $("[data-loading-percent]")
  const $spider = $("[data-loading-spider]")

  if ($overlay && $video && $percent && $spider) {
    document.body.classList.add("overflow-hidden")

    const finish = () => {
      document.body.classList.remove("overflow-hidden")
      $overlay.remove()
      markLoadingDone()
    }

    const setProgress = (value: number) => {
      $percent.textContent = `${Math.round(value)}%`
      $spider.style.setProperty("--progress", String(value / 100))
    }

    if (prefersReducedMotion()) {
      setProgress(100)
      finish()
    } else {
      $video.play().catch((error) => {
        console.error(error)
      })

      const counter = { value: 0 }

      gsap
        .timeline({ onComplete: finish })
        .to(counter, {
          value: 100,
          duration: 1.2,
          ease: "none",
          onUpdate: () => {
            setProgress(counter.value)
          },
          onComplete: markLoadingReady,
        })
        .to($overlay, {
          yPercent: -115,
          rotation: -7,
          duration: 0.6,
          ease: "power3.in",
        })
    }
  }
</script>
