---
import { SEO } from "@/consts"

const RELEASE_DATE = "29.07.26"

const PHRASES = [
  ["El mundo", "ha olvidado", "a Peter"],
  ["pero él", "no los ha", "olvidado"],
]
---

<section data-hero id="trailer" class="relative h-[520vh]">
  <!-- Único h1 del documento. El diseño confía el título al logo de la UI fija,
       así que aquí va sólo para lectores de pantalla y buscadores. -->
  <h1 class="sr-only">{SEO.title}</h1>

  <!-- Marcadores sin pintura: menú / CTA tráiler saben en qué punto del scroll estamos. -->
  <div data-hero-intro class="pointer-events-none absolute inset-x-0 top-0 h-screen" aria-hidden="true"></div>
  <div id="estreno" class="pointer-events-none absolute inset-x-0 top-[18%] h-[40%]" aria-hidden="true"></div>

  <div data-hero-stage class="sticky top-0 h-screen w-full overflow-hidden">
    <div data-hero-media class="absolute inset-0">
      <video
        data-hero-video
        class="absolute inset-0 h-full w-full object-cover"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/hero-poster-1280.webp"
        aria-hidden="true"
      >
        <source
          src="/videos/hero-854.webm"
          type='video/webm; codecs="av01.0.04M.08"'
          media="(max-width: 767px)"
        />
        <source
          src="/videos/hero-854.mp4"
          type="video/mp4"
          media="(max-width: 767px)"
        />
        <source
          src="/videos/hero-1920.webm"
          type='video/webm; codecs="av01.0.08M.08"'
        />
        <source src="/videos/hero-1920.mp4" type="video/mp4" />
      </video>
    </div>

    <svg
      data-date-cover
      class="absolute inset-0 h-full w-full opacity-0"
      viewBox="0 0 1000 300"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <filter
          id="hero-date-soft"
          x="-50%"
          y="-50%"
          width="200%"
          height="200%"
        >
          <feGaussianBlur data-date-blur stdDeviation="0"></feGaussianBlur>
        </filter>

        <mask
          id="hero-date-hole"
          maskUnits="userSpaceOnUse"
          x="-2000"
          y="-2000"
          width="5000"
          height="5000"
        >
          <rect x="-2000" y="-2000" width="5000" height="5000" fill="#fff"
          ></rect>
          <text
            data-date-text
            class="font-display"
            x="500"
            y="150"
            text-anchor="middle"
            dominant-baseline="central"
            font-size="250"
            letter-spacing="-6"
            fill="#000"
            fill-opacity="1"
            filter="url(#hero-date-soft)">{RELEASE_DATE}</text
          >
        </mask>
      </defs>

      <rect
        x="-2000"
        y="-2000"
        width="5000"
        height="5000"
        fill="#000004"
        mask="url(#hero-date-hole)"></rect>

      <!-- La misma fecha, ya opaca. Releva al hueco de la máscara al final del
           encogido: el hueco es una ventana al vídeo y no puede pintarse de un
           color, así que la fecha «normal» tiene que ser un texto aparte encima. -->
      <text
        data-date-fill
        class="font-display text-neutral-white"
        x="500"
        y="150"
        text-anchor="middle"
        dominant-baseline="central"
        font-size="250"
        letter-spacing="-6"
        fill="currentColor"
        opacity="0">{RELEASE_DATE}</text
      >
    </svg>

    <!-- Por encima del velo de la fecha y por debajo de las frases: cuando
         entra, la fecha ya se ha ido y el velo es negro a pantalla completa.
         El plano viene rodado sobre negro, así que no hace falta recortarlo ni
         fundirlo con nada: apoya sobre el velo sin costura. `preload="none"`
         porque el scrub lo arranca desde el script, y con movimiento reducido
         no llega a pedirse. -->
    <video
      data-hero-swing
      class="absolute inset-0 h-full w-full object-cover opacity-0"
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source
        src="/videos/spiderman-jump-810.webm"
        type='video/webm; codecs="av01.0.08M.08"'
        media="(max-width: 767px)"
      />
      <source
        src="/videos/spiderman-jump-810.mp4"
        type="video/mp4"
        media="(max-width: 767px)"
      />
      <source
        src="/videos/spiderman-jump-1440.webm"
        type='video/webm; codecs="av01.0.08M.08"'
      />
      <source src="/videos/spiderman-jump-1440.mp4" type="video/mp4" />
    </video>

    {
      PHRASES.map((lines) => (
        <p
          data-hero-phrase
          class="absolute inset-0 grid place-content-center px-6 text-center text-[clamp(2.5rem,11vw,8rem)] leading-[0.95] font-display uppercase text-neutral-white pointer-events-none"
        >
          {lines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </p>
      ))
    }
  </div>
</section>

<style>
  .video-fallback {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0a0a0a 100%);
  }
  .video-fallback::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(180, 30, 30, 0.15) 0%, transparent 70%);
  }
  .video-fallback video {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    section[data-hero] {
      height: 100vh;
    }

    [data-date-cover],
    [data-hero-swing] {
      display: none;
    }

    [data-hero-phrase] + [data-hero-phrase] {
      display: none;
    }
  }
</style>

<script>
  import { $, $$ } from "@/lib/dom"
  import { gsap, SplitText, prefersReducedMotion } from "@/lib/gsap"
  import { onLoadingReady } from "@/lib/loading"

  const $section = $("[data-hero]") as HTMLElement | null
  const $cover = $("[data-date-cover]") as SVGSVGElement | null
  const $dateText = $("[data-date-text]") as SVGTextElement | null
  const $dateBlur = $("[data-date-blur]") as SVGFEGaussianBlurElement | null
  const $dateFill = $("[data-date-fill]") as SVGTextElement | null
  const $heroVideo = $("[data-hero-video]") as HTMLVideoElement | null
  const $media = $("[data-hero-media]") as HTMLElement | null
  const $swing = $("[data-hero-swing]") as HTMLVideoElement | null

  const phrases = $$("[data-hero-phrase]")
  const reducedMotion = prefersReducedMotion()

  const BLUR = 24

  const letterDur = 2
  const letterStagger = 0.15
  const hold = 4

  /* La fecha entra desbordando la pantalla y baja hasta su tamaño legible: por
     el hueco de las letras sólo se ve el vídeo, y el velo negro se va cerrando
     alrededor según encoge. Se escala el <text> de la máscara en vez de animar
     `font-size`, así el interletraje se mantiene proporcional en todo el
     recorrido. */
  /** Tamaño de entrada, en múltiplos del final. A 4.5 apenas cabe un par de cifras. */
  const DATE_ZOOM = 4.5
  /** Centro del texto en coordenadas del viewBox: el escalado tira de ahí. */
  const DATE_ORIGIN = "500 150"
  /** Zoom de salida del plano de fondo, en paralelo a la fecha. */
  const MEDIA_ZOOM = 1.5
  /** Bajada de tamaño. */
  const DATE_IN = 26
  /** Relevo del hueco al texto opaco. Solapa el final del encogido en vez de ir
      detrás, para no reintroducir un tramo inmóvil. */
  const DATE_SWAP = 4
  /** Lo que aguanta la fecha ya legible antes de irse. Corto a propósito. */
  const DATE_HOLD = 2
  const DATE_OUT = 8
  /** La máscara sale un pelo después que el fondo, no a la vez. */
  const DATE_OFFSET = 0.5

  /** Fin del encogido: aquí la fecha ya está a tamaño y del todo opaca. */
  const DATE_SETTLED = DATE_OFFSET + DATE_IN
  const DATE_EXIT = DATE_SETTLED + DATE_HOLD
  /** Punto de la timeline en el que arrancan las frases: justo al irse la fecha. */
  const PHRASE_START = DATE_EXIT + DATE_OUT

  if ($heroVideo && !reducedMotion) {
    onLoadingReady(() => {
      $heroVideo.play().catch((error) => {
        console.error("Error al reproducir el video del héroe:", error)
        $heroVideo.parentElement?.classList.add("video-fallback")
      })
    })
  }

  if ($section && $cover && $dateText && $dateBlur && $dateFill && !reducedMotion) {
    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: $section,
        start: "top top",
        end: "bottom bottom",
        // Segundos que tarda la animación en alcanzar al scroll. Cuanto más
        // alto, más se desliza al soltar la rueda en vez de clavarse al frame.
        scrub: 1,
      },
    })

    tl.fromTo($cover, { opacity: 0 }, { opacity: 1, duration: 5 }, 0)
      // `power1.out` (cuadrática) y no algo de grado mayor: suaviza la llegada
      // sin aplanarse al final, que es lo que hacía que pareciera detenerse
      // antes de tiempo.
      // Los dos textos encogen a la vez y con la misma geometría: mientras uno
      // es hueco y el otro opaco quedan superpuestos al pixel.
      .fromTo(
        [$dateText, $dateFill],
        { scale: DATE_ZOOM, svgOrigin: DATE_ORIGIN },
        {
          scale: 1,
          svgOrigin: DATE_ORIGIN,
          duration: DATE_IN,
          ease: "power1.out",
        },
        DATE_OFFSET,
      )
      // Relevo: el hueco se cierra desenfocándose y debajo aparece la fecha en
      // gris. Termina justo cuando acaba el encogido.
      .to(
        $dateBlur,
        { attr: { stdDeviation: BLUR / 3 }, duration: DATE_SWAP },
        DATE_SETTLED - DATE_SWAP,
      )
      .to(
        $dateText,
        { attr: { "fill-opacity": 0 }, duration: DATE_SWAP },
        DATE_SETTLED - DATE_SWAP,
      )
      .fromTo(
        $dateFill,
        { opacity: 0 },
        { opacity: 1, duration: DATE_SWAP },
        DATE_SETTLED - DATE_SWAP,
      )
      // Salida: ya sólo queda el texto blanco, que sigue encogiendo y se apaga
      // desenfocándose. Mismo `BLUR` con el que entran y salen las frases, para
      // que la fecha se vaya con el mismo lenguaje con el que llegan ellas.
      .fromTo(
        $dateFill,
        { filter: "blur(0px)" },
        {
          scale: 0.4,
          svgOrigin: DATE_ORIGIN,
          opacity: 0,
          filter: `blur(${BLUR}px)`,
          duration: DATE_OUT,
        },
        DATE_EXIT,
      )

    // El plano de fondo abre cerrado y se aleja con la fecha: refuerza el «de
    // grande a pequeño» sin que el encuadre pegue un salto.
    if ($media) {
      tl.fromTo(
        $media,
        { scale: MEDIA_ZOOM },
        { scale: 1, duration: DATE_IN, ease: "power1.out" },
        0,
      )
    }

    let phraseAt = PHRASE_START

    phrases.forEach((phrase) => {
      const { chars } = SplitText.create(phrase, { type: "chars" })
      const revealSpan =
        letterDur + Math.max(0, chars.length - 1) * letterStagger

      gsap.set(chars, { opacity: 0 })

      tl.fromTo(
        chars,
        { opacity: 0, filter: `blur(${BLUR}px)` },
        {
          opacity: 1,
          filter: "blur(0px)",
          duration: letterDur,
          stagger: letterStagger,
        },
        phraseAt,
      )

      phraseAt += revealSpan + hold

      tl.to(
        chars,
        {
          opacity: 0,
          filter: `blur(${BLUR}px)`,
          duration: letterDur,
          stagger: { each: letterStagger, from: "start" },
        },
        phraseAt,
      )

      phraseAt += revealSpan
    })

    // El balanceo ocupa exactamente el tramo de las frases: entra con la
    // primera y el plano corto del final cae sobre la salida de la última,
    // que ya termina en negro y enlaza con la sección siguiente.
    //
    // El scrub va contra un objeto intermedio en vez de contra `currentTime`
    // directamente: la duración solo existe tras los metadatos, y el vídeo se
    // pide al vuelo. Con el proxy la timeline se monta entera de una y cada
    // frame resuelve el segundo que toca con lo que haya cargado.
    if ($swing) {
      const swing = { progress: 0 }

      $swing.load()

      tl.fromTo(
        $swing,
        { autoAlpha: 0 },
        { autoAlpha: 1, duration: 2 },
        PHRASE_START,
      )
        .to(
          swing,
          {
            progress: 1,
            duration: phraseAt - PHRASE_START,
            onUpdate: () => {
              if ($swing.readyState < HTMLMediaElement.HAVE_METADATA) return
              $swing.currentTime = swing.progress * $swing.duration
            },
          },
          PHRASE_START,
        )
        .to($swing, { autoAlpha: 0, duration: 2 }, phraseAt - 2)
    }
  }
</script>
