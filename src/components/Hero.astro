---
import { SEO } from "@/consts"

const RELEASE_DATE = "29.07.26"

/** La fecha se pinta dos veces —hueco de la máscara y texto opaco— y ambas
 *  tienen que caer al píxel: el relevo entre las dos es un fundido cruzado.
 *  La geometría vive aquí una sola vez para que no puedan desalinearse.
 *
 *  El interletrado sale del tamaño (−6 sobre 250 en el diseño original), así que
 *  las dos disposiciones comparten el mismo ajuste óptico sin repetir números. */
const linea = (texto: string, x: number, y: number, tamano: number) => ({
  texto,
  attrs: {
    x,
    y,
    "text-anchor": "middle",
    "dominant-baseline": "central",
    "font-size": tamano,
    "letter-spacing": Math.round(tamano * -0.024),
  },
})

/** Apaisado: la fecha entera en una línea, que es como está diseñada. */
const DATE_ANCHA = [linea(RELEASE_DATE, 500, 150, 250)]

/** Vertical: el ancho no da para la fecha entera sin dejarla diminuta, así que
 *  se parte por los puntos y cada bloque gana tamaño. Va centrada en el mismo
 *  (500,150) que la ancha, de modo que el `svgOrigin` del zoom sirve para las
 *  dos y el script no tiene que saber cuál está puesta. */
/** Los dos mandos del tamaño en vertical. Como el `viewBox` es apaisado y se
 *  ajusta con `meet`, el mapeo lo manda el ancho de la pantalla, no el alto: por
 *  eso el tamaño se fija contra las 1000 unidades del ancho, que es la
 *  referencia estable entre teléfonos. El paso va en proporción al bloque
 *  (1,17×, medido del diseño) para que el aire entre líneas no dependa de lo
 *  alargado que sea el móvil ni haya que reajustarlo al cambiar el tamaño. */
const DATE_ALTA_TAMANO = 290
const DATE_ALTA_PASO = Math.round(DATE_ALTA_TAMANO * 1.17)
const DATE_ALTA = RELEASE_DATE.split(".").map((bloque, i) =>
  linea(bloque, 500, 150 + (i - 1) * DATE_ALTA_PASO, DATE_ALTA_TAMANO),
)

const PHRASES = [
  ["El mundo", "ha olvidado", "a Peter"],
  ["pero él", "no los ha", "olvidado"],
]
---

<!-- 640vh y no 520: el hero ha ganado una fase (el encogido de la fecha) y con
     el alto anterior el reposo de la fecha se lo habría comido a las frases.
     Con este alto el scroll por unidad de timeline queda como estaba. -->
<section data-hero id="trailer" class="relative h-[640vh]">
  <!-- Único h1 del documento. El diseño confía el título al logo de la UI fija,
       así que aquí va sólo para lectores de pantalla y buscadores. -->
  <h1 class="sr-only">{SEO.title}</h1>

  <!-- Marcadores sin pintura: menú / CTA tráiler saben en qué punto del scroll estamos. -->
  <div data-hero-intro class="pointer-events-none absolute inset-x-0 top-0 h-screen" aria-hidden="true"></div>
  <!-- El menú salta al borde superior de este marcador, así que tiene que caer
       dentro del reposo de la fecha: es la sección que existe para enseñarla.
       El reposo va del 37,3% al 48,9% del alto de la sección; 43% lo centra.
       Es independiente del viewport porque alto y rango escalan los dos con vh.
       Se recalcula si cambian `DATE_IN`, `DATE_HOLD` o el alto de la sección. -->
  <div id="estreno" class="pointer-events-none absolute inset-x-0 top-[43%] h-[40%]" aria-hidden="true"></div>

  <div data-hero-stage class="sticky top-0 h-screen w-full overflow-hidden">
    <div data-hero-media class="absolute inset-0">
      <video
        data-hero-video
        class="absolute inset-0 h-full w-full object-cover"
        muted
        loop
        playsinline
        preload="metadata"
        poster="/images/hero-poster-1280.webp"
        aria-hidden="true"
      >
        <source
          src="/videos/hero-854.webm"
          type='video/webm; codecs="av01.0.04M.08"'
          media="(max-width: 767px)"
        />
        <source
          src="/videos/hero-854.mp4"
          type="video/mp4"
          media="(max-width: 767px)"
        />
        <source
          src="/videos/hero-1920.webm"
          type='video/webm; codecs="av01.0.08M.08"'
        />
        <source src="/videos/hero-1920.mp4" type="video/mp4" />
      </video>
    </div>

    <svg
      data-date-cover
      class="absolute inset-0 h-full w-full opacity-0"
      viewBox="0 0 1000 300"
      preserveAspectRatio="xMidYMid meet"
      aria-hidden="true"
    >
      <defs>
        <filter
          id="hero-date-soft"
          x="-50%"
          y="-50%"
          width="200%"
          height="200%"
        >
          <feGaussianBlur data-date-blur stdDeviation="0"></feGaussianBlur>
        </filter>

        <mask
          id="hero-date-hole"
          maskUnits="userSpaceOnUse"
          x="-2000"
          y="-2000"
          width="5000"
          height="5000"
        >
          <rect x="-2000" y="-2000" width="5000" height="5000" fill="#fff"
          ></rect>
          <!-- El negro abre el hueco por el que se ve el vídeo. `fill` y
               `fill-opacity` van en el grupo: los <text> los heredan, así que el
               relevo se anima en un solo sitio. -->
          <g
            data-date-hole
            class="font-display"
            fill="#000"
            fill-opacity="1"
            filter="url(#hero-date-soft)"
          >
            <g class="date-layout--ancha">
              {DATE_ANCHA.map((l) => <text {...l.attrs}>{l.texto}</text>)}
            </g>
            <g class="date-layout--alta">
              {DATE_ALTA.map((l) => <text {...l.attrs}>{l.texto}</text>)}
            </g>
          </g>
        </mask>
      </defs>

      <rect
        x="-2000"
        y="-2000"
        width="5000"
        height="5000"
        fill="#000004"
        mask="url(#hero-date-hole)"></rect>

      <!-- La misma fecha, ya opaca. Releva al hueco de la máscara al final del
           encogido: el hueco es una ventana al vídeo y no puede pintarse de un
           color, así que la fecha «normal» tiene que ser un texto aparte encima. -->
      <g
        data-date-fill
        class="font-display text-neutral-white"
        fill="currentColor"
        opacity="0"
      >
        <g class="date-layout--ancha">
          {DATE_ANCHA.map((l) => <text {...l.attrs}>{l.texto}</text>)}
        </g>
        <g class="date-layout--alta">
          {DATE_ALTA.map((l) => <text {...l.attrs}>{l.texto}</text>)}
        </g>
      </g>
    </svg>

    <!-- Por encima del velo de la fecha y por debajo de las frases: cuando
         entra, la fecha ya se ha ido y el velo es negro a pantalla completa.
         El plano viene rodado sobre negro, así que no hace falta recortarlo ni
         fundirlo con nada: apoya sobre el velo sin costura. `preload="none"`
         porque el scrub lo arranca desde el script, y con movimiento reducido
         no llega a pedirse. -->
    <video
      data-hero-swing
      class="absolute inset-0 h-full w-full object-cover opacity-0"
      muted
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source
        src="/videos/spiderman-jump-810.webm"
        type='video/webm; codecs="av01.0.08M.08"'
        media="(max-width: 767px)"
      />
      <source
        src="/videos/spiderman-jump-810.mp4"
        type="video/mp4"
        media="(max-width: 767px)"
      />
      <source
        src="/videos/spiderman-jump-1440.webm"
        type='video/webm; codecs="av01.0.08M.08"'
      />
      <source src="/videos/spiderman-jump-1440.mp4" type="video/mp4" />
    </video>

    {
      PHRASES.map((lines) => (
        <p
          data-hero-phrase
          class="absolute inset-0 grid place-content-center px-6 text-center text-[clamp(2.5rem,11vw,8rem)] leading-[0.95] font-display uppercase text-neutral-white pointer-events-none"
        >
          {lines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </p>
      ))
    }
  </div>
</section>

<style>
  /* Sólo una de las dos disposiciones de la fecha se pinta. El corte es por
     ancho —mismo que el resto de la UI fija (`sm`, 640px)— más una proporción
     mínima: la disposición apilada necesita un alto de al menos 1,115 veces el
     ancho, así que por debajo de eso se recortaría por arriba y por abajo. El
     4/5 deja margen sobre ese 1,115 por si la fuente carga distinta. */
  .date-layout--alta {
    display: none;
  }

  @media (max-width: 639px) and (max-aspect-ratio: 4/5) {
    .date-layout--ancha {
      display: none;
    }

    .date-layout--alta {
      display: inline;
    }
  }

  .video-fallback {
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #0a0a0a 100%);
  }
  .video-fallback::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgba(180, 30, 30, 0.15) 0%, transparent 70%);
  }
  .video-fallback video {
    opacity: 0;
  }

  /* Sin movimiento, pero no sin contenido. El hero se queda en una pantalla y
     enseña el velo con la fecha ya en su estado final: es la imagen que
     identifica la sección y la única del hero que da el día de estreno.
     Ocultarla dejaba fuera justo lo que la página viene a contar. */
  @media (prefers-reduced-motion: reduce) {
    section[data-hero] {
      height: 100vh;
    }

    /* La timeline abre el velo desde `opacity: 0`; sin timeline hay que
       abrirlo aquí. El resto del estado final ya viene del marcado: el texto
       de la máscara nace a `font-size: 250` y el desenfoque a `0`. */
    [data-date-cover] {
      opacity: 1;
    }

    /* El balanceo se reproduce con scrub contra el scroll: sin timeline no
       tiene un fotograma que enseñar.
       Las frases se van con él. Están superpuestas entre sí y caen sobre la
       fecha, así que en una sola pantalla quieta no caben las dos cosas; entre
       el texto de ambiente y la fecha de estreno, se queda la fecha. */
    [data-hero-swing],
    [data-hero-phrase] {
      display: none;
    }
  }
</style>

<script>
  import { $, $$ } from "@/lib/dom"
  import { gsap, SplitText, prefersReducedMotion } from "@/lib/gsap"
  import { onLoadingReady } from "@/lib/loading"

  const $section = $("[data-hero]") as HTMLElement | null
  const $cover = $("[data-date-cover]") as SVGSVGElement | null
  const $dateHole = $("[data-date-hole]") as SVGGElement | null
  const $dateBlur = $("[data-date-blur]") as SVGFEGaussianBlurElement | null
  const $dateFill = $("[data-date-fill]") as SVGGElement | null
  const $heroVideo = $("[data-hero-video]") as HTMLVideoElement | null
  const $media = $("[data-hero-media]") as HTMLElement | null
  const $swing = $("[data-hero-swing]") as HTMLVideoElement | null

  const phrases = $$("[data-hero-phrase]")
  const reducedMotion = prefersReducedMotion()

  const BLUR = 24

  const letterDur = 2
  const letterStagger = 0.15
  const hold = 4

  /* La fecha entra desbordando la pantalla y baja hasta su tamaño legible: por
     el hueco de las letras sólo se ve el vídeo, y el velo negro se va cerrando
     alrededor según encoge. Se escala el <text> de la máscara en vez de animar
     `font-size`, así el interletraje se mantiene proporcional en todo el
     recorrido. */
  /** Tamaño de entrada, en múltiplos del final. */
  const DATE_ZOOM = 6
  /** Centro del texto en coordenadas del viewBox: el escalado tira de ahí. */
  const DATE_ORIGIN = "500 150"
  /** Zoom de entrada del plano de fondo: abre cerrado y se aleja a 1. */
  const MEDIA_ZOOM = 1.5
  /** Entrada del velo. Corta a propósito: si el velo tarda en opacarse, el paso
      de «pantalla llena de vídeo» a «números» lo hace el fundido y no el
      encogido. Opaco desde pronto, quien cierra la imagen son las letras. */
  const COVER_IN = 2
  /** Bajada de tamaño. Se lleva la mayor parte del scroll de la fecha: es el
      movimiento, y quedarse quieto cuesta más caro al que scrollea. */
  const DATE_IN = 38
  /** Relevo del hueco al texto opaco. Solapa el final del encogido en vez de ir
      detrás, para no reintroducir un tramo inmóvil. */
  const DATE_SWAP = 4
  /** Lo que aguanta la fecha legible antes de irse. Suficiente para leerla sin
      prisa (~595 px de scroll), pero sin que la pantalla se quede congelada.
      Si se toca, hay que recalcular el `top-[…]` del marcador `#estreno`. */
  const DATE_HOLD = 12
  const DATE_OUT = 8
  /** La máscara entra un pelo después que el fondo, no a la vez. */
  const DATE_OFFSET = 0.5

  /** Fin del encogido: aquí la fecha ya está a tamaño y del todo opaca. */
  const DATE_SETTLED = DATE_OFFSET + DATE_IN
  const DATE_EXIT = DATE_SETTLED + DATE_HOLD
  /** Punto de la timeline en el que arrancan las frases: justo al irse la fecha. */
  const PHRASE_START = DATE_EXIT + DATE_OUT

  if ($heroVideo && !reducedMotion) {
    onLoadingReady(() => {
      $heroVideo.play().catch((error) => {
        console.error("Error al reproducir el video del héroe:", error)
        $heroVideo.parentElement?.classList.add("video-fallback")
      })
    })
  }

  if (
    $section &&
    $cover &&
    $dateHole &&
    $dateBlur &&
    $dateFill &&
    $media &&
    !reducedMotion
  ) {
    const tl = gsap.timeline({
      defaults: { ease: "none" },
      scrollTrigger: {
        trigger: $section,
        start: "top top",
        end: "bottom bottom",
        // Segundos que tarda la animación en alcanzar al scroll. Cuanto más
        // alto, más se desliza al soltar la rueda en vez de clavarse al frame.
        scrub: 1,
      },
    })

    tl.fromTo($cover, { opacity: 0 }, { opacity: 1, duration: COVER_IN }, 0)
      // `power1.out` (cuadrática) y no algo de grado mayor: suaviza la llegada
      // sin aplanarse al final, que es lo que hacía que pareciera detenerse
      // antes de tiempo.
      // Las dos capas encogen a la vez y con la misma geometría: mientras una
      // es hueco y la otra opaca quedan superpuestas al pixel. El zoom va sobre
      // los grupos, así que da igual qué disposición esté puesta.
      .fromTo(
        [$dateHole, $dateFill],
        { scale: DATE_ZOOM, svgOrigin: DATE_ORIGIN },
        {
          scale: 1,
          svgOrigin: DATE_ORIGIN,
          duration: DATE_IN,
          ease: "power1.out",
        },
        DATE_OFFSET,
      )
      // Relevo: el hueco se cierra desenfocándose y debajo aparece la fecha en
      // blanco. Termina justo cuando acaba el encogido.
      .to(
        $dateBlur,
        { attr: { stdDeviation: BLUR / 3 }, duration: DATE_SWAP },
        DATE_SETTLED - DATE_SWAP,
      )
      .to(
        $dateHole,
        { attr: { "fill-opacity": 0 }, duration: DATE_SWAP },
        DATE_SETTLED - DATE_SWAP,
      )
      .fromTo(
        $dateFill,
        { opacity: 0 },
        { opacity: 1, duration: DATE_SWAP },
        DATE_SETTLED - DATE_SWAP,
      )
      // Salida: ya sólo queda el texto blanco, que sigue encogiendo y se apaga
      // desenfocándose. Mismo `BLUR` con el que entran y salen las frases, para
      // que la fecha se vaya con el mismo lenguaje con el que llegan ellas.
      .fromTo(
        $dateFill,
        { filter: "blur(0px)" },
        {
          scale: 0.4,
          svgOrigin: DATE_ORIGIN,
          opacity: 0,
          filter: `blur(${BLUR}px)`,
          duration: DATE_OUT,
        },
        DATE_EXIT,
      )

    // El plano de fondo abre cerrado y se aleja con la fecha: refuerza el «de
    // grande a pequeño» sin que el encuadre pegue un salto.
    tl.fromTo(
      $media,
      { scale: MEDIA_ZOOM },
      { scale: 1, duration: DATE_IN, ease: "power1.out" },
      0,
    )

    let phraseAt = PHRASE_START

    phrases.forEach((phrase) => {
      const { chars } = SplitText.create(phrase, { type: "chars" })
      const revealSpan =
        letterDur + Math.max(0, chars.length - 1) * letterStagger

      gsap.set(chars, { opacity: 0 })

      tl.fromTo(
        chars,
        { opacity: 0, filter: `blur(${BLUR}px)` },
        {
          opacity: 1,
          filter: "blur(0px)",
          duration: letterDur,
          stagger: letterStagger,
        },
        phraseAt,
      )

      phraseAt += revealSpan + hold

      tl.to(
        chars,
        {
          opacity: 0,
          filter: `blur(${BLUR}px)`,
          duration: letterDur,
          stagger: { each: letterStagger, from: "start" },
        },
        phraseAt,
      )

      phraseAt += revealSpan
    })

    // El balanceo ocupa exactamente el tramo de las frases: entra con la
    // primera y el plano corto del final cae sobre la salida de la última,
    // que ya termina en negro y enlaza con la sección siguiente.
    //
    // El scrub va contra un objeto intermedio en vez de contra `currentTime`
    // directamente: la duración solo existe tras los metadatos, y el vídeo se
    // pide al vuelo. Con el proxy la timeline se monta entera de una y cada
    // frame resuelve el segundo que toca con lo que haya cargado.
    if ($swing) {
      const swing = { progress: 0 }

      $swing.load()

      tl.fromTo(
        $swing,
        { autoAlpha: 0 },
        { autoAlpha: 1, duration: 2 },
        PHRASE_START,
      )
        .to(
          swing,
          {
            progress: 1,
            duration: phraseAt - PHRASE_START,
            onUpdate: () => {
              if ($swing.readyState < HTMLMediaElement.HAVE_METADATA) return
              $swing.currentTime = swing.progress * $swing.duration
            },
          },
          PHRASE_START,
        )
        .to($swing, { autoAlpha: 0, duration: 2 }, phraseAt - 2)
    }
  }
</script>
