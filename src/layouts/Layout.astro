---
import Seo from "@/components/Seo.astro"

import "../styles/global.css"

interface Props {
  title?: string
  description?: string
  image?: string
  imageAlt?: string
  type?: 'website' | 'video.movie'
  noindex?: boolean
}

const { title, description, image, imageAlt, type, noindex } = Astro.props
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="theme-color" content="#000004" />
    <meta name="color-scheme" content="dark" />

    <link
      rel="preload"
      href="/fonts/anton-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
