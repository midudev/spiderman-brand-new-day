---
import Layout from "@/layouts/Layout.astro"
import Loading from "@/components/Loading.astro"
import Hero from "@/components/Hero.astro"
import Sinopsis from "@/components/Sinopsis.astro"
import Videos from "@/components/Videos.astro"
import Galeria from "@/components/Galeria.astro"
import Footer from "@/components/Footer.astro"
import FixedUI from "@/components/fixed/FixedUI.astro"
---

<Layout type="video.movie">
  <Loading />
  <FixedUI />
  <main class="bg-neutral-black">
    <Hero />
    <Sinopsis />
    <Videos />
    <Galeria />
    <Footer />
  </main>
</Layout>
